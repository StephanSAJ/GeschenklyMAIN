$all_popular_products = gtc_get_most_popular_products($term_id, $taxonomy);
$personas = gtc_get_term_personas($term_id);
$selected_sub_terms = isset($term_meta['gtc_selected_sub_terms'][0]) ? maybe_unserialize($term_meta['gtc_selected_sub_terms'][0]) : array();
$custom_sub_term_texts = isset($term_meta['gtc_custom_sub_term_texts'][0]) ? maybe_unserialize($term_meta['gtc_custom_sub_term_texts'][0]) : array();
$rising_products = gtc_get_rising_products($term_id, $taxonomy, 4);
$custom_description = isset($term_meta['gtc_custom_description'][0]) ? $term_meta['gtc_custom_description'][0] : '';
$custom_header_text = isset($term_meta['gtc_custom_header_text'][0]) ? $term_meta['gtc_custom_header_text'][0] : '';
$gtc_image = isset($term_meta['gtc_image'][0]) ? $term_meta['gtc_image'][0] : '';
$term_name = $term->name;
$term_description = $term->description;
$trending_sub_terms = gtc_get_trending_sub_terms($term_id, $taxonomy, $selected_sub_terms);
function gtc_render_optimized_product_image($product, $index) {
    $image_id = get_post_thumbnail_id($product['id']);
    $image_url = wp_get_attachment_image_url($image_id, 'woocommerce_thumbnail');
    $image_alt = get_post_meta($image_id, '_wp_attachment_image_alt', true);
    $loading = $index < 3 ? 'eager' : 'lazy';
    $decoding = $index < 3 ? 'sync' : 'async';
    $fetchpriority = $index === 0 ? 'high' : 'low';
    $class = $index === 0 ? 'product-image lcp-image' : 'product-image';
    $srcset = wp_get_attachment_image_srcset($image_id, 'woocommerce_thumbnail');
    $sizes = wp_get_attachment_image_sizes($image_id, 'woocommerce_thumbnail');
    printf(
        '<img src="%1$s" alt="%2$s" width="300" height="300" loading="%3$s" decoding="%4$s" fetchpriority="%5$s" class="%6$s" srcset="%7$s" sizes="%8$s">',
        esc_url($image_url), esc_attr($image_alt), $loading, $decoding, $fetchpriority, $class, $srcset, $sizes
    );
}
function gtc_render_optimized_term_image($term_name, $gtc_image) {
    $term_image_url = '';
    if ($gtc_image) {
        $term_image_url = wp_get_attachment_image_url($gtc_image, 'medium');
    }
    $default_image = '/wp-content/uploads/2024/07/category-placeholder.webp';
    printf(
        '<img width="180" height="180" fetchpriority="high" src="%s" alt="%s" class="term-image" loading="eager" decoding="sync">',
        esc_url($term_image_url ?: $default_image), esc_attr($term_name)
    );
}
