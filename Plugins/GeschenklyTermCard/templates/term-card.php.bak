        <div class="sub-terms">
            <?php
            if (!empty($selected_sub_terms)) {
                foreach ($selected_sub_terms as $sub_term_id) {
                    $sub_term = get_term($sub_term_id);
                    if ($sub_term && !is_wp_error($sub_term)) {
                        $custom_text = isset($custom_sub_term_texts[$sub_term_id]) ? $custom_sub_term_texts[$sub_term_id] : $sub_term->description;
                        $custom_text = trim($custom_text); // Entfernt extra Whitespace/leere Zeilen
                        $sub_term_image_id = get_term_meta($sub_term_id, 'gtc_image', true);
                        $image_url = $sub_term_image_id ? wp_get_attachment_image_url($sub_term_image_id, 'full') : '';
                        echo '<a class="term-tag-card" href="' . esc_url(get_term_link($sub_term)) . '">';
                        if ($image_url) {
                            echo '<div class="term-tag-image" style="background-image: url(\'' . esc_url($image_url) . '\');"></div>';
                        } else {
                            echo '<div class="term-tag-image" style="background-image: url(\'' . esc_url('https://geschenkly.de/wp-content/uploads/2024/07/DALL·E-2024-07-26-16.28.35-Create-an-illustration-for-the-Gifts-for-Men-category-designed-to-fit-into-a-placeholder-space-with-a-friendly-and-inviting-vibe.-The-scene-should-.webp') . '\');"></div>';
                        }
                        echo '<div class="term-tag-content">';
                        echo '<h3>' . esc_html($sub_term->name) . '</h3>';
                        echo '<p>' . esc_html($custom_text) . '</p>';
                        echo '</div>';
                        echo '</a>';
                    }
                }
            } else {
                echo '<p>Keine Unterbegriffe ausgewählt.</p>';
            }
            ?>
        </div>
        <?php if (!empty($custom_description)): ?>
            <div class="custom-description-card">
                <h3>Wissenswertes zum Thema "<?php echo esc_html($term_name); ?>"</h3>
                <div class="custom-description-content">
                    <?php echo wpautop($custom_description); ?>
                </div>
            </div>
        <?php endif; ?>
        <div class="filter-section term-insights">
<h3>Unsere Partner-Shops für "<?php echo esc_html($term_name); ?>"</h3>
            <div class="filter-buttons partner-grid">
                <?php
                $selected_partner_shops = isset($term_meta['gtc_selected_partner_shops'][0]) ? maybe_unserialize($term_meta['gtc_selected_partner_shops'][0]) : array();
                $partner_shops = get_option('wcc_partner_shops', []);
                if (!empty($selected_partner_shops) && !empty($partner_shops)) {
                    foreach ($selected_partner_shops as $shop_index) {
                        if (isset($partner_shops[$shop_index])) {
                            $shop = $partner_shops[$shop_index];
                            $logo_url = wp_get_attachment_image_url($shop['logo'], 'medium');
                            if (!$logo_url) {
                                $logo_url = 'http://placehold.it/100x100';
                            }
                            ?>
                            <a rel="sponsored" href="<?php echo esc_url($shop['url']); ?>" class="filter-button partner-card" target="_blank">
                                <img src="<?php echo esc_url($logo_url); ?>" alt="<?php echo esc_attr($shop['name']); ?> Logo">
                                <span><?php echo esc_html($shop['name']); ?></span>
                            </a>
                            <?php
                        }
                    }
                } else {
                    echo '<p>Keine Partner-Shops für diesen Begriff ausgewählt.</p>';
                }
                ?>
            </div>
<div id="awp-wishlist-app"></div>
